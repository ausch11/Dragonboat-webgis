# Copy to .env if you want to change the defaults. No configuration is needed to run.
APP_HOST=127.0.0.1
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
APP_PORT=8000
DATABASE_PATH=data/app.sqlite3
# These passwords are only used when initializing a new database.
ADMIN_INITIAL_PASSWORD=Admin@12345
DEMO_INITIAL_PASSWORD=User@12345
# Set 1 only behind an HTTPS reverse proxy.
COOKIE_SECURE=0
# Optional: a provider's full HTTPS Chat Completions endpoint, key and model ID.
# Keep these blank to use local knowledge retrieval and event search.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Only visible tiles are requested when the user clicks the online-map button.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
